{
  "name": "@fursquared/f2-app-scratch-post",
  "version": "0.4.5",
  "description": "The Scratch Post canvas micro app for FurSquared",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "assets",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets/scratch-post.webp": "./assets/scratch-post.webp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FurSquared/f2-app-scratch-post.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "npm run typecheck",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^7.3.2"
  }
}
